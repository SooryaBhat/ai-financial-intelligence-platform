{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALLADIN Knowledge Document Metadata",
  "type": "object",
  "required": ["document_id","title","author","issuing_organization","publication_year","topic","content_type","review_status","license_reuse_status"],
  "properties": {
    "document_id": {"type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{2,3}$", "description": "e.g. BG-01 for business guide 01"},
    "title": {"type": "string"},
    "author": {"type": ["string","null"]},
    "issuing_organization": {"type": ["string","null"]},
    "publication_year": {"type": ["integer","null"]},
    "topic": {"type": "string"},
    "chapter": {"type": ["string","null"]},
    "section": {"type": ["string","null"]},
    "page_number": {"type": ["string","integer","null"], "description": "Only if the original source supports it; never guessed"},
    "source_url": {"type": ["string","null"], "format": "uri"},
    "source_file": {"type": ["string","null"]},
    "license_reuse_status": {"type": "string"},
    "content_type": {"enum": ["official_source","book","internal_guide","AI_assisted_draft","fictional_case_study"]},
    "review_status": {"enum": ["unreviewed","in_review","reviewed","needs_update","deprecated"]},
    "applicable_region": {"type": ["string","null"], "description": "e.g. 'general', 'India'"},
    "tenant_scope": {"enum": ["global","tenant_private"], "default": "global", "description": "tenant_private documents must be filtered by company_id at retrieval time"},
    "tenant_id": {"type": ["string","null"]}
  },
  "allOf": [
    {"if": {"properties": {"tenant_scope": {"const": "tenant_private"}}, "required": ["tenant_scope"]},
     "then": {"required": ["tenant_id"], "properties": {"tenant_id": {"type": "string"}}}}
  ]
}
